{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "firefly-bookmarks",
	"main": "admin/bookmarks/worker.mjs",
	"compatibility_date": "2026-07-29",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "codefromkarl.xyz/admin/bookmarks*",
			"zone_name": "codefromkarl.xyz"
		}
	],
	"ai": { "binding": "AI" }
}
