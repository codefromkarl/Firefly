---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const techStackPost = await getEntry("spec", "tech-stack");

if (!techStackPost) {
	throw new Error("Tech stack page content not found");
}

const { Content } = await render(techStackPost);
---

<MainGridLayout
	title="技术栈"
	description="CodeFromKarl 的核心技术栈与代表项目"
>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
