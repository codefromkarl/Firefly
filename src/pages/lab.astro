---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const labPost = await getEntry("spec", "lab");

if (!labPost) {
	throw new Error("Lab page content not found");
}

const { Content } = await render(labPost);
---

<MainGridLayout
	title="实验室"
	description="CodeFromKarl 的实践笔记、实验过程与复盘总结"
>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div class="card-base z-10 px-9 py-6 relative w-full">
			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
