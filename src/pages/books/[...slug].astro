---
import { getImage, Image } from "astro:assets";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import BookSidebar from "@/components/pages/books/BookSidebar.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { BOOK_SHELF_LABELS, BOOK_STATUS_LABELS } from "@/types/book";
import { getPublishedBooks, toBookDirectoryItems } from "@/utils/book-utils";

export async function getStaticPaths() {
	const books = await getPublishedBooks();
	return books.map((book) => ({
		params: { slug: book.id },
		props: { book },
	}));
}

const { book } = Astro.props;
const headings: MarkdownHeading[] = [
	{ depth: 2, slug: "book-introduction", text: "整本书介绍" },
	{ depth: 2, slug: "why-read", text: "这本书值得看的地方" },
	{ depth: 2, slug: "classic-excerpts", text: "经典摘抄" },
];
const directoryBooks = toBookDirectoryItems(await getPublishedBooks());
const introductionSources = [
	...new Map(
		book.data.introductions.map((introduction) => [
			introduction.url,
			introduction,
		]),
	).values(),
];
const optimizedCover = await getImage({
	src: book.data.cover,
	width: 720,
	format: "webp",
	quality: 82,
});
const absoluteCover = new URL(
	optimizedCover.src,
	Astro.site ?? Astro.url.origin,
).toString();

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Book",
	name: book.data.title,
	alternateName: book.data.originalTitle,
	author: book.data.authors.map((name: string) => ({
		"@type": "Person",
		name,
	})),
	description: book.data.description,
	inLanguage: book.data.language,
	isbn: book.data.isbn,
	image: absoluteCover,
	url: Astro.url.href,
};
---

<MainGridLayout
	title={book.data.title}
	description={book.data.description}
	lang={book.data.language}
	headings={headings}
>
	<BookSidebar
		slot="left-sidebar"
		books={directoryBooks}
		currentBookId={book.id}
	/>

	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>

	<article data-pagefind-body>
		<section
			id="book-introduction"
			aria-labelledby="book-introduction-heading"
			class="card-base mb-5 overflow-hidden rounded-(--radius-large)"
		>
			<div class="grid gap-0 md:grid-cols-[minmax(13rem,0.7fr)_minmax(0,1.8fr)]">
				<div class="relative aspect-2/3 overflow-hidden bg-(--btn-regular-bg) md:aspect-auto md:min-h-[32rem]">
					<Image
						src={book.data.cover}
						alt={`《${book.data.title}》封面`}
						widths={[360, 540, 720]}
						sizes="(max-width: 768px) 100vw, 32vw"
						format="webp"
						quality={82}
						loading="eager"
						fetchpriority="high"
						decoding="async"
						class="absolute inset-0 h-full w-full p-4 object-contain md:p-6"
					/>
				</div>

				<div class="flex flex-col p-6 md:p-9">
					<div class="flex flex-wrap gap-2">
						<span
							class="rounded-full bg-(--primary) px-3 py-1.5 text-xs font-semibold text-white dark:text-black/80"
						>
							{BOOK_STATUS_LABELS[book.data.status]}
						</span>
						<span
							class="rounded-full bg-black/5 px-3 py-1.5 text-xs font-semibold text-neutral-600 dark:bg-white/10 dark:text-neutral-300"
							data-pagefind-filter={`book-shelf:${BOOK_SHELF_LABELS[book.data.shelf]}`}
						>
							{BOOK_SHELF_LABELS[book.data.shelf]}
						</span>
					</div>

					<h1
						id="book-introduction-heading"
						class="mt-6 text-3xl font-bold leading-tight text-neutral-900 dark:text-neutral-100 md:text-4xl"
						data-pagefind-meta="title"
					>
						{book.data.title}
					</h1>
					{book.data.originalTitle && (
						<p class="mt-2 text-sm text-neutral-400">{book.data.originalTitle}</p>
					)}
					<p class="mt-4 text-base text-neutral-600 dark:text-neutral-300">
						{book.data.authors.join("、")}
					</p>

					<div class="mt-7">
						<h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
							书籍简介
						</h2>
						<div class="mt-3 space-y-3 text-base leading-8 text-neutral-700 dark:text-neutral-200">
							{book.data.introductions.map((introduction) => (
								<p>{introduction.text}</p>
							))}
						</div>
						<div class="mt-5 border-t border-(--line-divider) pt-4">
							<p class="text-xs font-semibold tracking-wide text-neutral-400">
								简介来源
							</p>
							<div class="mt-2 flex flex-wrap gap-x-4 gap-y-2 text-sm">
								{introductionSources.map((introduction) => (
									<a
										href={introduction.url}
										target="_blank"
										rel="noreferrer"
										class="inline-flex items-center gap-1 font-medium text-(--primary) hover:underline"
									>
										{introduction.source}
										<Icon is:inline name="lucide:external-link" class="text-base" />
									</a>
								))}
							</div>
						</div>
					</div>

					<div class="mt-6 flex flex-wrap gap-2">
						{book.data.topics.map((topic: string) => (
							<span
								class="rounded-full bg-black/5 px-3 py-1.5 text-xs text-neutral-500 dark:bg-white/10 dark:text-neutral-400"
								data-pagefind-filter={`book-topic:${topic}`}
							>
								#{topic}
							</span>
						))}
					</div>

					<div class="mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-7 text-sm text-neutral-500 dark:text-neutral-400">
						<span class="inline-flex items-center gap-2">
							<Icon is:inline name="lucide:globe" class="text-lg" />
							{book.data.language}
						</span>
						{book.data.isbn && (
							<span class="inline-flex items-center gap-2">
								<Icon is:inline name="lucide:barcode" class="text-lg" />
								ISBN {book.data.isbn}
							</span>
						)}
					</div>
				</div>
			</div>
		</section>

		<section
			id="why-read"
			aria-labelledby="why-read-heading"
			class="card-base mb-5 rounded-(--radius-large) p-6 md:p-9"
		>
			<h2
				id="why-read-heading"
				class="text-2xl font-bold text-neutral-900 dark:text-neutral-100"
			>
				这本书值得看的地方
			</h2>
			<div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
				{book.data.readingReasons.map((reason) => (
					<blockquote class="flex h-full flex-col rounded-2xl border border-(--line-divider) bg-(--btn-regular-bg)/45 p-5">
						<Icon
							is:inline
							name="lucide:quote"
							class="text-3xl text-(--primary)"
							aria-hidden="true"
						/>
						<h3 class="mt-2 text-lg font-bold leading-7 text-neutral-900 dark:text-neutral-100">
							{reason.title}
						</h3>
						<p class="mt-2 grow text-base leading-8 text-neutral-700 dark:text-neutral-200">
							“{reason.text}”
						</p>
						<footer class="mt-4 border-t border-(--line-divider) pt-4 text-sm text-neutral-500 dark:text-neutral-400">
							<p>— {reason.source}</p>
							<a
								href={reason.url}
								target="_blank"
								rel="noreferrer"
								class="mt-2 inline-flex items-center gap-1 font-medium text-(--primary) hover:underline"
							>
								查看依据来源
								<Icon is:inline name="lucide:external-link" class="text-base" />
							</a>
						</footer>
					</blockquote>
				))}
			</div>
			{book.data.endorsements.length > 0 && (
				<div class="mt-7 border-t border-(--line-divider) pt-6">
					<h3 class="text-sm font-semibold tracking-wide text-neutral-500 dark:text-neutral-400">
						名家与媒体评价
					</h3>
					<div class="mt-3 grid gap-3">
						{book.data.endorsements.map((endorsement) => (
							<blockquote class="text-sm leading-7 text-neutral-600 dark:text-neutral-300">
								“{endorsement.text}”
								<footer class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-neutral-500 dark:text-neutral-400">
									<span>— {endorsement.source}</span>
									<a
										href={endorsement.url}
										target="_blank"
										rel="noreferrer"
										class="inline-flex items-center gap-1 font-medium text-(--primary) hover:underline"
									>
										查看评价来源
										<Icon is:inline name="lucide:external-link" class="text-base" />
									</a>
								</footer>
							</blockquote>
						))}
					</div>
				</div>
			)}
		</section>

		<section
			id="classic-excerpts"
			aria-labelledby="classic-excerpts-heading"
			class="card-base rounded-(--radius-large) p-6 md:p-9"
		>
			<h2
				id="classic-excerpts-heading"
				class="text-2xl font-bold text-neutral-900 dark:text-neutral-100"
			>
				经典文章与句子摘抄
			</h2>
			{book.data.excerpts.length > 0 ? (
				<ol class="mt-6 grid gap-4">
					{book.data.excerpts.map((excerpt, index) => (
						<li class="rounded-2xl border border-(--line-divider) bg-(--btn-regular-bg)/45 p-5">
							<div class="flex items-start gap-4">
								<span
									class="flex size-8 shrink-0 items-center justify-center rounded-full bg-(--primary)/12 text-sm font-bold text-(--primary)"
									aria-hidden="true"
								>
									{index + 1}
								</span>
								<blockquote class="min-w-0">
									<p class="text-base leading-8 text-neutral-700 dark:text-neutral-200">
										“{excerpt.text}”
									</p>
									<footer class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm text-neutral-500 dark:text-neutral-400">
										<span>— {excerpt.source}</span>
										{excerpt.url && (
											<a
												href={excerpt.url}
												target="_blank"
												rel="noreferrer"
												class="inline-flex items-center gap-1 font-medium text-(--primary) hover:underline"
											>
												核对公开原文
												<Icon
													is:inline
													name="lucide:external-link"
													class="text-base"
												/>
											</a>
										)}
									</footer>
								</blockquote>
							</div>
						</li>
					))}
				</ol>
			) : (
				<div class="mt-6 rounded-2xl border border-dashed border-(--line-divider) px-5 py-9 text-center">
					<p class="font-medium text-neutral-700 dark:text-neutral-200">
						尚未添加经原文核对的摘抄
					</p>
					<p class="mt-2 text-sm leading-6 text-neutral-500 dark:text-neutral-400">
						核对具体版本后再补充。
					</p>
				</div>
			)}
		</section>
	</article>
</MainGridLayout>
