---
import { getImage, Image } from "astro:assets";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import BookSidebar from "@/components/pages/books/BookSidebar.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { BOOK_SHELF_LABELS, BOOK_STATUS_LABELS } from "@/types/book";
import { getPublishedBooks, toBookDirectoryItems } from "@/utils/book-utils";
import { url } from "@/utils/url-utils";

export async function getStaticPaths() {
	const books = await getPublishedBooks();
	return books.map((book) => ({
		params: { slug: book.id },
		props: { book },
	}));
}

const { book } = Astro.props;
const headings: MarkdownHeading[] = [
	{ depth: 2, slug: "book-overview", text: "内容概述" },
];
const directoryBooks = toBookDirectoryItems(await getPublishedBooks());
// 封面源统一为 480px 宽，故不再生成更大的尺寸（放大只会模糊）
const optimizedCover = await getImage({
	src: book.data.cover,
	width: 480,
	format: "webp",
	quality: 82,
});
const absoluteCover = new URL(
	optimizedCover.src,
	Astro.site ?? Astro.url.origin,
).toString();
const shelfUrl = `${url("/books/")}?shelf=${book.data.shelf}`;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "Book",
	name: book.data.title,
	alternateName: book.data.originalTitle,
	author: book.data.authors.map((name: string) => ({
		"@type": "Person",
		name,
	})),
	description: book.data.description,
	inLanguage: book.data.language,
	isbn: book.data.isbn,
	image: absoluteCover,
	url: Astro.url.href,
};
---

<MainGridLayout
	title={book.data.title}
	description={book.data.description}
	lang={book.data.language}
	headings={headings}
>
	<BookSidebar
		slot="left-sidebar"
		books={directoryBooks}
		currentBookId={book.id}
	/>

	<script
		is:inline
		slot="head"
		type="application/ld+json"
		set:html={JSON.stringify(jsonLd)}
	/>

	<article data-pagefind-body>
		<section
			id="book-overview"
			aria-labelledby="book-overview-heading"
			class="card-base overflow-hidden rounded-(--radius-large)"
		>
			<div class="grid gap-0 md:grid-cols-[minmax(13rem,0.7fr)_minmax(0,1.8fr)]">
				<div class="relative aspect-2/3 overflow-hidden bg-(--btn-regular-bg) md:aspect-auto md:min-h-[32rem]">
					<Image
						src={book.data.cover}
						alt={`《${book.data.title}》封面`}
						widths={[240, 360, 480]}
						sizes="(max-width: 768px) 100vw, 32vw"
						format="webp"
						quality={82}
						loading="eager"
						fetchpriority="high"
						decoding="async"
						class="absolute inset-0 h-full w-full p-4 object-contain md:p-6"
					/>
					{book.data.coverSource === "placeholder" && (
						<span class="absolute bottom-3 left-3 rounded-full bg-black/60 px-2.5 py-1 text-xs font-medium text-white">
							封面待补
						</span>
					)}
				</div>

				<div class="flex flex-col p-6 md:p-9">
					<div class="flex flex-wrap gap-2">
						<span
							class="rounded-full bg-(--primary) px-3 py-1.5 text-xs font-semibold text-white dark:text-black/80"
						>
							{BOOK_STATUS_LABELS[book.data.status]}
						</span>
						<a
							href={shelfUrl}
							class="rounded-full bg-black/5 px-3 py-1.5 text-xs font-semibold text-neutral-600 transition hover:bg-black/10 dark:bg-white/10 dark:text-neutral-300 dark:hover:bg-white/20"
							data-pagefind-filter={`book-shelf:${BOOK_SHELF_LABELS[book.data.shelf]}`}
						>
							{BOOK_SHELF_LABELS[book.data.shelf]}
						</a>
					</div>

					<h1
						id="book-overview-heading"
						class="mt-6 text-3xl font-bold leading-tight text-neutral-900 dark:text-neutral-100 md:text-4xl"
						data-pagefind-meta="title"
					>
						{book.data.title}
					</h1>
					{book.data.originalTitle && (
						<p class="mt-2 text-sm text-neutral-400">{book.data.originalTitle}</p>
					)}
					<p class="mt-4 text-base text-neutral-600 dark:text-neutral-300">
						{book.data.authors.join("、")}
					</p>

					<div class="mt-7">
						<h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100">
							内容概述
						</h2>
						<p class="mt-3 text-base leading-8 text-neutral-700 dark:text-neutral-200">
							{book.data.description}
						</p>
						<p class="mt-2 text-xs text-neutral-400">
							内容概述（自撰），非出版方原文
						</p>
					</div>

					{book.data.topics.length > 0 && (
						<div class="mt-6 flex flex-wrap gap-2">
							{book.data.topics.map((topic: string) => (
								<span
									class="rounded-full bg-black/5 px-3 py-1.5 text-xs text-neutral-500 dark:bg-white/10 dark:text-neutral-400"
									data-pagefind-filter={`book-topic:${topic}`}
								>
									#{topic}
								</span>
							))}
						</div>
					)}

					<div class="mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-7 text-sm text-neutral-500 dark:text-neutral-400">
						<span class="inline-flex items-center gap-2">
							<Icon is:inline name="lucide:globe" class="text-lg" />
							{book.data.language}
						</span>
						{book.data.isbn && (
							<span class="inline-flex items-center gap-2">
								<Icon is:inline name="lucide:barcode" class="text-lg" />
								ISBN {book.data.isbn}
							</span>
						)}
					</div>
				</div>
			</div>
		</section>
	</article>
</MainGridLayout>
